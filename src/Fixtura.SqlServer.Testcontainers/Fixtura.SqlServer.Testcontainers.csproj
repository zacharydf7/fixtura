<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQL Server in a Docker container for Fixtura test hosts: one container per test run, started on first use and shared by every fixture, each with its own databases. Without Docker the fixture's tests skip with the reason; with the "required" variable set, as in CI, they fail.</Description>
    <!-- Ships the doc comments for IntelliSense. Comments describe only what needs explaining, so a member or parameter
         without one doesn't fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The oldest version whose SSH.NET dependency has no known vulnerability. -->
    <PackageReference Include="Testcontainers.MsSql" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fixtura.SqlServer\Fixtura.SqlServer.csproj" />
  </ItemGroup>

</Project>
