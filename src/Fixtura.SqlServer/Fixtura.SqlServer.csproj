<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQL Server for Fixtura test hosts: a server from an environment variable or LocalDB, one prefixed database per name per fixture, dropped when the fixture is done. Without a server the fixture's tests skip with the reason; with the "required" variable set, as in CI, they fail.</Description>
    <!-- Ships the doc comments for IntelliSense. Comments describe only what needs explaining, so a member or parameter
         without one doesn't fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SqlClient version EF Core 10.0.0's SQL Server provider uses, so a consumer's own references never move. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- SqlClient's own Pkcs dependency has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fixtura\Fixtura.csproj" />
  </ItemGroup>

</Project>
