<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- With -p:UseMinimumMvcTesting=true, Mvc.Testing comes only through Fixtura, at the oldest version it supports. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" Condition="'$(UseMinimumMvcTesting)' != 'true'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fixtura\Fixtura.csproj" />
    <ProjectReference Include="..\..\src\Fixtura.EntityFrameworkCore\Fixtura.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Fixtura.SqlServer\Fixtura.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Fixtura.PostgreSql\Fixtura.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Fixtura.PostgreSql.Testcontainers\Fixtura.PostgreSql.Testcontainers.csproj" />
    <ProjectReference Include="..\..\src\Fixtura.Sqlite\Fixtura.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Fixtura.Grpc\Fixtura.Grpc.csproj" />
    <ProjectReference Include="..\..\src\Fixtura.Playwright\Fixtura.Playwright.csproj" />
    <ProjectReference Include="..\..\src\Fixtura.SignalR\Fixtura.SignalR.csproj" />
    <ProjectReference Include="..\..\src\Fixtura.SqlServer.Testcontainers\Fixtura.SqlServer.Testcontainers.csproj" />
    <ProjectReference Include="..\SampleApps\SampleApp\SampleApp.csproj" />
    <ProjectReference Include="..\SampleApps\AuthorityJwtApp\AuthorityJwtApp.csproj" />
    <ProjectReference Include="..\SampleApps\CookieApp\CookieApp.csproj" />
    <ProjectReference Include="..\SampleApps\CookieIdentityApp\CookieIdentityApp.csproj" />
    <ProjectReference Include="..\SampleApps\SymmetricJwtApp\SymmetricJwtApp.csproj" />
  </ItemGroup>

</Project>
